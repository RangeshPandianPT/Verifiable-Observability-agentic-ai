# Verifiable Observability — Environment Configuration
# Copy this file to .env in the project root and fill in your keys.
# Never commit .env to version control.

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Model overrides (optional) ─────────────────────────────────────────────
# Anthropic model to use (default: claude-3-5-sonnet-20241022)
# VO_MODEL=claude-3-5-sonnet-20241022

# OpenAI model to use (default: gpt-4o)
# VO_OPENAI_MODEL=gpt-4o

# Max tokens per completion (default: 1024)
# VO_MAX_TOKENS=1024

# Sampling temperature: 0 = deterministic, 1 = max creativity (default: 0)
# VO_TEMPERATURE=0
